# ========================================================
# CẤU HÌNH MÔI TRƯỜNG - SLR PAPER FETCHER
# ========================================================

# 1. Cấu hình Email dùng cho Unpaywall API (Tìm kiếm Open Access miễn phí)
UNPAYWALL_EMAIL=bot@vnulib.edu.vn

# 2. Cấu hình Cổng truy cập từ xa ĐHQG-HCM (OpenAthens Redirector)
VNU_OPENATHENS_BASE_URL=https://go.openathens.net/redirector/vnu.edu.vn?url=

# 3. Thông tin tài khoản Thư viện ĐHQG-HCM (Lưu trữ để tiện đối chiếu / quản lý)
VNU_LIBRARY_ID=1100002598002
VNU_LIBRARY_PASSWORD=12345678

# 4. Cấu hình Server & Giao diện
APP_HOST=127.0.0.1
APP_PORT=8543
AUTO_OPEN_BROWSER=true

# 5. Thư mục lưu trữ bài báo đã tải về
DOWNLOAD_FOLDER=./downloads
