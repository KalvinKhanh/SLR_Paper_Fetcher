# Template cấu hình môi trường
UNPAYWALL_EMAIL=your_email@domain.com
# Legacy compatibility only; automatic downloads use the VNU web account.
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
OPENALEX_API_KEY=
VNU_ALLOW_MANUAL_VERIFICATION=true
# Use exactly the selected browser; Windows defaults to Edge. Set chrome to use Chrome.
VNU_BROWSER_CHANNEL=msedge
VNU_BROWSER_HEADLESS=false
VNU_VERIFICATION_WAIT_SECONDS=180
VNU_OPENATHENS_BASE_URL=https://go.openathens.net/redirector/vnu.edu.vn?url=
VNU_LIBRARY_ID=
VNU_LIBRARY_PASSWORD=
APP_HOST=127.0.0.1
APP_PORT=8543
AUTO_OPEN_BROWSER=true
DOWNLOAD_FOLDER=./downloads
